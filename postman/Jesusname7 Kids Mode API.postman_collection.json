{
  "info": {
    "name": "Jesusname7 Kids Mode API",
    "description": "Kids Mode setup, parental PIN entry/exit, screen-time status, kids-only feed, and kids Reel upload examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "mediaAssetId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Kids Mode",
      "item": [
        {
          "name": "1. Setup and Activate Kids Mode",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"123456\",\n  \"confirmPin\": \"123456\",\n  \"childNickname\": \"Rokey\",\n  \"ageGroup\": \"7-9\",\n  \"dailyLimitMinutes\": 61\n}"
            },
            "url": "{{baseUrl}}/kids-mode/setup",
            "description": "First setup activates Kids Mode. To change an existing setup, also send currentPin. PIN must contain exactly six digits."
          }
        },
        {
          "name": "2. Get Kids Mode Status",
          "request": { "method": "GET", "url": "{{baseUrl}}/kids-mode/status" }
        },
        {
          "name": "3. Exit Kids Mode with PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pin\": \"123456\"\n}" },
            "url": "{{baseUrl}}/kids-mode/exit"
          }
        },
        {
          "name": "4. Enter Kids Mode with PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pin\": \"123456\"\n}" },
            "url": "{{baseUrl}}/kids-mode/enter"
          }
        },
        {
          "name": "5. Get Kids-only Feed",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/kids-mode/feed?limit=20",
            "description": "Requires active Kids Mode. Returns only public, ready videos uploaded with kids=true. Reported videos and videos with three or more reports are excluded."
          }
        },
        {
          "name": "6. Update Kids Settings",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPin\": \"123456\",\n  \"pin\": \"654321\",\n  \"confirmPin\": \"654321\",\n  \"childNickname\": \"Rokey\",\n  \"ageGroup\": \"10-15\",\n  \"dailyLimitMinutes\": 90\n}"
            },
            "url": "{{baseUrl}}/kids-mode/setup"
          }
        }
      ]
    },
    {
      "name": "Upload Kids Reel",
      "item": [
        {
          "name": "Create Reel with kids=true",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "kids-reel-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaAssetId\": \"{{mediaAssetId}}\",\n  \"mediaType\": \"video\",\n  \"caption\": \"Kids-friendly video\",\n  \"kids\": true,\n  \"visibility\": \"public\"\n}"
            },
            "url": "{{baseUrl}}/reels",
            "description": "The public API accepts kids. It is stored using the existing internal forKids field for backward compatibility."
          }
        }
      ]
    }
  ]
}
