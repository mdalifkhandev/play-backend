{
  "info": {
    "_postman_id": "e7fa0ca2-9e61-4db9-945a-0771fa23fb19",
    "name": "Jesusname7 Push Notifications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "deviceToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register Push Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{deviceToken}}\",\n  \"platform\": \"android\",\n  \"deviceId\": \"postman-device-1\",\n  \"appVersion\": \"1.0.0\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "tokens"
          ]
        }
      }
    },
    {
      "name": "Send Push Notification To Me",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Jesusname7\",\n  \"body\": \"This is a push notification test from Postman.\",\n  \"data\": {\n    \"type\": \"test\",\n    \"screen\": \"notifications\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/send",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "send"
          ]
        }
      }
    },
    {
      "name": "Admin Send Push Notification To User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"New update\",\n  \"body\": \"You have a new notification.\",\n  \"imageUrl\": \"https://example.com/notification.png\",\n  \"data\": {\n    \"type\": \"admin_message\",\n    \"screen\": \"home\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/admin/send",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "admin",
            "send"
          ]
        }
      }
    },
    {
      "name": "Remove Push Token",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{deviceToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "tokens"
          ]
        }
      }
    }
  ]
}
