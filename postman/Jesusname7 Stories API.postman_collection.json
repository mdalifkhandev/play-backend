{
  "info": {
    "name": "Jesusname7 Stories API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "uploadId", "value": "" },
    { "key": "mediaAssetId", "value": "" },
    { "key": "storyId", "value": "" },
    { "key": "idempotencyKey", "value": "story-demo-001" },
    { "key": "cloudinaryUploadUrl", "value": "" },
    { "key": "cloudinaryApiKey", "value": "" },
    { "key": "cloudinaryTimestamp", "value": "" },
    { "key": "cloudinarySignature", "value": "" },
    { "key": "cloudinaryPublicId", "value": "" },
    { "key": "cloudinaryResourceType", "value": "image" }
  ],
  "item": [
    {
      "name": "01 Prepare Image Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('prepared', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('uploadId', json.data.uploadId);",
              "pm.collectionVariables.set('cloudinaryUploadUrl', json.data.uploadUrl);",
              "pm.collectionVariables.set('cloudinaryApiKey', json.data.apiKey);",
              "pm.collectionVariables.set('cloudinaryTimestamp', String(json.data.timestamp));",
              "pm.collectionVariables.set('cloudinarySignature', json.data.signature);",
              "pm.collectionVariables.set('cloudinaryPublicId', json.data.publicId);",
              "pm.collectionVariables.set('cloudinaryResourceType', json.data.resourceType);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/uploads/prepare",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mediaType\": \"image\",\n  \"mimeType\": \"image/jpeg\",\n  \"fileSizeBytes\": 524288\n}"
        }
      }
    },
    {
      "name": "02 Upload File To Cloudinary",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{cloudinaryUploadUrl}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": [] },
            { "key": "api_key", "value": "{{cloudinaryApiKey}}", "type": "text" },
            { "key": "timestamp", "value": "{{cloudinaryTimestamp}}", "type": "text" },
            { "key": "signature", "value": "{{cloudinarySignature}}", "type": "text" },
            { "key": "public_id", "value": "{{cloudinaryPublicId}}", "type": "text" },
            { "key": "overwrite", "value": "false", "type": "text" }
          ]
        }
      }
    },
    {
      "name": "03 Complete Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('verified', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('mediaAssetId', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/uploads/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uploadId\": \"{{uploadId}}\"\n}"
        }
      }
    },
    {
      "name": "04 Publish Image Story",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('published', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('storyId', json.data.story.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/stories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mediaAssetId\": \"{{mediaAssetId}}\",\n  \"mediaType\": \"image\",\n  \"displayDurationSeconds\": 5,\n  \"caption\": \"First Story\"\n}"
        }
      }
    },
    {
      "name": "05 Story Feed",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/stories?limit=20"
      }
    },
    {
      "name": "06 Get Story",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/stories/{{storyId}}"
      }
    },
    {
      "name": "07 Record Story View",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stories/{{storyId}}/views"
      }
    },
    {
      "name": "08 Delete Story",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stories/{{storyId}}"
      }
    },
    {
      "name": "09 Publish Video Story",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Idempotency-Key", "value": "video-{{idempotencyKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/stories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mediaAssetId\": \"{{mediaAssetId}}\",\n  \"mediaType\": \"video\",\n  \"videoEditing\": {\n    \"trimStartSeconds\": 0,\n    \"trimEndSeconds\": 15,\n    \"originalAudioEnabled\": true,\n    \"originalAudioVolume\": 1\n  },\n  \"music\": {\n    \"provider\": \"jamendo\",\n    \"providerTrackId\": \"12345\",\n    \"startTimeSeconds\": 0,\n    \"clipDurationSeconds\": 15,\n    \"volume\": 0.8\n  }\n}"
        }
      }
    }
  ]
}
