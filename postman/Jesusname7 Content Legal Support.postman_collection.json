{
  "info": {
    "_postman_id": "b1cdeea4-fb91-4e66-a718-60c563ecb730",
    "name": "Jesusname7 Content, Legal & Support API",
    "description": "Production API flow for versioned content pages, legal consent and support tickets. Run requests in collection order after setting the admin email and password variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "origin", "value": "http://localhost:3000" },
    { "key": "email", "value": "ratul990054@gmail.com" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "currentUserId", "value": "" },
    { "key": "aboutUsPageId", "value": "" },
    { "key": "privacyPolicyPageId", "value": "" },
    { "key": "termsConditionsPageId", "value": "" },
    { "key": "deletableDraftId", "value": "" },
    { "key": "privacyVersion", "value": "1" },
    { "key": "termsVersion", "value": "1" },
    { "key": "supportRequestId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Origin', value: pm.collectionVariables.get('origin') || 'http://localhost:3000' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response uses the API contract', function () {",
          "  const json = pm.response.json();",
          "  pm.expect(json).to.have.property('success');",
          "  if (!json.success) pm.expect(json.error).to.have.property('requestId');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "01 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.tokens?.accessToken) pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
                  "if (json?.data?.user?.id) pm.collectionVariables.set('currentUserId', json.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02 Admin Content Pages",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "01 Create About Us Draft",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const page = pm.response.json()?.data?.page;",
                "if (page?.id) pm.collectionVariables.set('aboutUsPageId', page.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageType\": \"about-us\",\n  \"title\": \"About Us\",\n  \"sections\": [\n    { \"heading\": \"About Us\", \"content\": \"Jesusname7 is a community-driven music and creator platform.\", \"order\": 0 },\n    { \"heading\": \"Our Mission\", \"content\": \"We help creators connect with their audience through safe and meaningful experiences.\", \"order\": 1 },\n    { \"heading\": \"Our Vision\", \"content\": \"Build a trusted global platform where creativity and community grow together.\", \"order\": 2 }\n  ],\n  \"changeSummary\": \"Initial About Us content\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/content-pages", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages"] }
          }
        },
        {
          "name": "02 Update About Us Draft",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changeSummary\": \"Reviewed initial About Us content\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{aboutUsPageId}}", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{aboutUsPageId}}"] }
          }
        },
        {
          "name": "03 Publish About Us",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{aboutUsPageId}}/publish", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{aboutUsPageId}}", "publish"] }
          }
        },
        {
          "name": "04 Create Privacy Policy Draft",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const page = pm.response.json()?.data?.page;",
                "if (page?.id) pm.collectionVariables.set('privacyPolicyPageId', page.id);",
                "if (page?.version) pm.collectionVariables.set('privacyVersion', String(page.version));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageType\": \"privacy-policy\",\n  \"title\": \"Privacy Policy\",\n  \"sections\": [\n    { \"heading\": \"Information We Collect\", \"content\": \"We collect account, profile, device and usage information needed to provide and secure the service.\", \"order\": 0 },\n    { \"heading\": \"How We Use Information\", \"content\": \"We use information to operate, improve, personalize and protect Jesusname7.\", \"order\": 1 },\n    { \"heading\": \"Information Sharing\", \"content\": \"We share information only with authorized providers, when legally required, or with your direction.\", \"order\": 2 }\n  ],\n  \"changeSummary\": \"Initial Privacy Policy\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/content-pages", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages"] }
          }
        },
        {
          "name": "05 Publish Privacy Policy",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{privacyPolicyPageId}}/publish", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{privacyPolicyPageId}}", "publish"] }
          }
        },
        {
          "name": "06 Create Terms Draft",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const page = pm.response.json()?.data?.page;",
                "if (page?.id) pm.collectionVariables.set('termsConditionsPageId', page.id);",
                "if (page?.version) pm.collectionVariables.set('termsVersion', String(page.version));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageType\": \"terms-conditions\",\n  \"title\": \"Terms & Conditions\",\n  \"sections\": [\n    { \"heading\": \"Use of the Service\", \"content\": \"You must use Jesusname7 lawfully and comply with these terms.\", \"order\": 0 },\n    { \"heading\": \"User Responsibilities\", \"content\": \"You are responsible for your account, content and activity on the service.\", \"order\": 1 },\n    { \"heading\": \"Account and Access\", \"content\": \"Keep your credentials secure and notify us promptly of unauthorized access.\", \"order\": 2 }\n  ],\n  \"changeSummary\": \"Initial Terms and Conditions\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/content-pages", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages"] }
          }
        },
        {
          "name": "07 Publish Terms",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{termsConditionsPageId}}/publish", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{termsConditionsPageId}}", "publish"] }
          }
        },
        {
          "name": "08 List All Versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/content-pages?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "09 Get Privacy Version By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{privacyPolicyPageId}}", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{privacyPolicyPageId}}"] }
          }
        },
        {
          "name": "10 Create Deletable Draft",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const id = pm.response.json()?.data?.page?.id;",
                "if (id) pm.collectionVariables.set('deletableDraftId', id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageType\": \"about-us\",\n  \"title\": \"Temporary Draft\",\n  \"sections\": [{ \"heading\": \"Temporary\", \"content\": \"This draft will be deleted.\", \"order\": 0 }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/content-pages", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages"] }
          }
        },
        {
          "name": "11 Delete Draft",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/content-pages/{{deletableDraftId}}", "host": ["{{baseUrl}}"], "path": ["admin", "content-pages", "{{deletableDraftId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 Public Content Pages",
      "item": [
        { "name": "01 Get About Us", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/content-pages/about-us", "host": ["{{baseUrl}}"], "path": ["content-pages", "about-us"] } } },
        { "name": "02 Get Privacy Policy", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/content-pages/privacy-policy", "host": ["{{baseUrl}}"], "path": ["content-pages", "privacy-policy"] } } },
        { "name": "03 Get Terms and Conditions", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/content-pages/terms-conditions", "host": ["{{baseUrl}}"], "path": ["content-pages", "terms-conditions"] } } }
      ]
    },
    {
      "name": "04 Legal Consent",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "01 Get Current Consent Status",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/legal-consents/current", "host": ["{{baseUrl}}"], "path": ["legal-consents", "current"] } }
        },
        {
          "name": "02 Accept Privacy Policy",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documentType\": \"privacy-policy\",\n  \"version\": {{privacyVersion}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/legal-consents/accept", "host": ["{{baseUrl}}"], "path": ["legal-consents", "accept"] }
          }
        },
        {
          "name": "03 Accept Terms and Conditions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documentType\": \"terms-conditions\",\n  \"version\": {{termsVersion}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/legal-consents/accept", "host": ["{{baseUrl}}"], "path": ["legal-consents", "accept"] }
          }
        }
      ]
    },
    {
      "name": "05 User Support Requests",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "01 Create Support Request",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const id = pm.response.json()?.data?.request?.id;",
                "if (id) pm.collectionVariables.set('supportRequestId', id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"technical\",\n  \"subject\": \"Unable to update my creator profile\",\n  \"message\": \"My creator profile changes are not appearing after I submit the form.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/support-requests", "host": ["{{baseUrl}}"], "path": ["support-requests"] }
          }
        },
        {
          "name": "02 List My Support Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/support-requests?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["support-requests"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "03 Get My Support Request",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/support-requests/{{supportRequestId}}", "host": ["{{baseUrl}}"], "path": ["support-requests", "{{supportRequestId}}"] } }
        },
        {
          "name": "04 User Reply",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"The issue still happens after signing in again.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/support-requests/{{supportRequestId}}/messages", "host": ["{{baseUrl}}"], "path": ["support-requests", "{{supportRequestId}}", "messages"] }
          }
        }
      ]
    },
    {
      "name": "06 Admin Support Requests",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "01 List All Support Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/support-requests?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin", "support-requests"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "02 Get Support Request",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/support-requests/{{supportRequestId}}", "host": ["{{baseUrl}}"], "path": ["admin", "support-requests", "{{supportRequestId}}"] } }
        },
        {
          "name": "03 Update Status Priority and Assignee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"assignedTo\": \"{{currentUserId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/support-requests/{{supportRequestId}}", "host": ["{{baseUrl}}"], "path": ["admin", "support-requests", "{{supportRequestId}}"] }
          }
        },
        {
          "name": "04 Admin Reply",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"We are reviewing the profile update logs and will follow up shortly.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/support-requests/{{supportRequestId}}/messages", "host": ["{{baseUrl}}"], "path": ["admin", "support-requests", "{{supportRequestId}}", "messages"] }
          }
        }
      ]
    },
    {
      "name": "07 Close Support Request",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/support-requests/{{supportRequestId}}/close", "host": ["{{baseUrl}}"], "path": ["support-requests", "{{supportRequestId}}", "close"] }
      }
    }
  ]
}
