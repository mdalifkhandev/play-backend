{
  "name": "jesusname7-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "mongoose": "^9.8.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
