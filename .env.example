NODE_ENV=development
PORT=3000

DATABASE_URL=
DATABASE_MAX_POOL_SIZE=20
DATABASE_MIN_POOL_SIZE=0
DATABASE_SERVER_SELECTION_TIMEOUT_MS=30000
DATABASE_SOCKET_TIMEOUT_MS=45000
DATABASE_MAX_IDLE_TIME_MS=60000
DATABASE_AUTO_INDEX=false

REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_CACHE_KEY_PREFIX=jesusname7:cache
REDIS_BULLMQ_PREFIX=jesusname7

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_REDACT_CENSOR=[REDACTED]
SERVICE_NAME=jesusname7-backend

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=jesusname7
